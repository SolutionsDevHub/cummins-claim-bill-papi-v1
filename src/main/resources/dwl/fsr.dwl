%dw 2.0
output application/java
---
{
	("Actual_Resolution_Date__c": payload.actualResolutionDate as Date) if(!isEmpty(payload.actualResolutionDate)),
	"Actual_Resolution_Date_Confidence__c": payload.actualResolutionDateConfidenceScore,
	("Air_Cleaner_Replaced_Date__c": payload.airCleanerElementReplacedHrsAndDate as Date) if(!isEmpty(payload.airCleanerElementReplacedHrsAndDate)),
	"Air_Cleaner_Replaced_Date_Confidence__c": payload.airCleanerElementReplacedHrsAndDateConfidenceScore,
	("Attended_On__c": payload.attendedOn as Date) if(!isEmpty(payload.attendedOn)),
	"Attended_On_Confidence__c": payload.attendedOnConfidenceScore,
	("Battery_Replaced_Date__c": payload.batteryReplacedAtHrsAndDate as Date) if(!isEmpty(payload.batteryReplacedAtHrsAndDate)),
	"Battery_Replaced_Date_Confidence__c": payload.batteryReplacedAtHrsAndDateConfidenceScore,
	"Branch_Code__c": payload.branchCode,
	"Branch_Code_Confidence__c": payload.branchCodeConfidenceScore,
	"Contact_No__c": payload.contactNumber,
	"Contact_No_Confidence__c": payload.contactNumberConfidenceScore,
	"Contact_Person_Name__c": payload.contactPersonName,
	"Contact_Person_Name_Confidence__c": payload.contactPersonNameConfidenceScore,
	("Coolant_Replaced_Date__c": payload.coolantReplacedAtHrsAndDate as Date) if(!isEmpty(payload.coolantReplacedAtHrsAndDate)),
	"Coolant_Replaced_Date_Confidence__c": payload.coolantReplacedAtHrsAndDateConfidenceScore,
	"Cumulative_Hours__c": payload.cumulativeHours,
	"Cumulative_Hours_Confidence__c": payload.cumulativeHoursConfidenceScore,
	"Current_Hours__c": payload.currentHours,
	"Current_Hours_Confidence__c": payload.currentHoursConfidenceScore,
	"Customer_Address__c": payload.customerAddress,
	"Customer_Address_Confidence__c": payload.customerAddressConfidenceScore,
	"Customer_Complaint__c": payload.customerComplaint,
	"Customer_Complaint_Confidence__c": payload.customerComplaintConfidenceScore,
	"Customer_Name__c": payload.customerName,
	"Customer_Name_Confidence__c": payload.customerNameConfidenceScore,
	("Customer_Requested_On__c": payload.customerRequestedOn as Date) if(!isEmpty(payload.customerRequestedOn)),
	"Customer_Requested_On_Confidence__c": payload.customerRequestedOnConfidenceScore,
	"Customer_Signature__c": if ( upper(payload.customerSignature) =="YES" ) true else false,
	"Customer_Signature_Confidence__c": payload.customerSignatureConfidenceScore,
	"Customer_Signature_Date__c": payload.customerSignatureDate,
	"Customer_Signature_Date_Confidence__c": payload.customerSignatureDateConfidenceScore,
	"Customer_Stamp__c": if ( upper(payload.customerStamp) =="YES" ) true else false,
	"Customer_Stamp_Confidence__c": payload.customerStampConfidenceScore,
	"Dealer_Name__c": payload.dealerName,
	"Dealer_Name_Confidence__c": payload.dealerNameConfidenceScore,
	("Diagnosis_Completed_On__c": payload.diagnosisCompletedOn as Date) if(!isEmpty(payload.diagnosisCompletedOn)),
	"Diagnosis_Completed_On_Confidence__c": payload.diagnosisCompletedOnConfidenceScore,
	"Digital_Failure_Code__c": payload.digitalFailureCode,
	"Digital_Failure_Code_Confidence__c": payload.digitalFailureCodeConfidenceScore,
	"Employee_Number__c": payload.employeeNumber,
	"Employee_Number_Confidence__c": payload.employeeNumberConfidenceScore,
	"Engine_Model__c": payload.engineModel,
	"Engine_Model_Confidence__c": payload.engineModelConfidenceScore,
	"ESN__c": payload.esn,
	"ESN_Confidence__c": payload.esnConfidenceScore,
	("Failure_Date__c": payload.failureDate as Date) if(!isEmpty(payload.failureDate)),
	"Failure_Date_Confidence__c": payload.failureDateConfidenceScore,
	("Failure_Reported_On__c": payload.failureReportedOn as Date) if(!isEmpty(payload.failureReportedOn)),
	"Failure_Reported_On_Confidence__c": payload.failureReportedOnConfidenceScore,
	("FSR_Date__c": payload.fsrDate as Date) if(!isEmpty(payload.fsrDate)),
	"FSR_Date_Confidence__c": payload.fsrDateConfidenceScore,
	"FSR_No__c": if ( upper(payload.fsrNumber) =="YES" ) true else false,
	"FSR_No_Confidence__c": payload.fsrNumberConfidenceScore,
	"Gen_Equp_Model__c": payload.genEqupModel,
	"Gen_Equp_Model_Confidence__c": payload.genEqupModelConfidenceScore,
	"Inspection_Work_Done__c": payload.inspectionObservationAndWorkDoneInBrief,
	"Inspection_Work_Done_Confidence__c": payload.inspectionObservationAndWorkDoneInBriefConfidenceScore,
	"KVA_Rating__c": payload.kvaRating,
	"KVA_Rating_Confidence__c": payload.kvaRatingConfidenceScore,
	("Last_B_Check_done_at_Hrs_Date__c": payload.lastBCheck as Date) if(!isEmpty(payload.lastBCheck)),
	"Last_B_Check_Done_Hrs_Date_Confidence__c": payload.lastBCheckConfidenceScore,
	("Last_C_Check_done_at_Hrs_Date__c": payload.lastCCheck as Date) if(!isEmpty(payload.lastCCheck)),
	"Last_C_Check_Done_Hrs_Date_Confidence__c": payload.lastCCheckConfidenceScore,
	("Last_D_Check_done_at_Hrs_Date__c": payload.lastDCheck as Date) if(!isEmpty(payload.lastDCheck)),
	"Last_D_Check_Done_Hrs_Date_Confidence__c": payload.lastDCheckConfidenceScore,
	"Problem_Resolution__c": payload.problemResolution,
	"Problem_Resolution_Confidence__c": payload.problemResolutionConfidenceScore,
	"Problem_Status__c": payload.problemStatus,
	"Problem_Status_Confidence__c": payload.problemStatusConfidenceScore,
	"Recommendation_Suggestion__c": payload.recommendationAndSuggestion,
	"Recommendation_Suggestion_Confidence__c": payload.recommendationAndSuggestionConfidenceScore,
	("Required_Material_Received_On__c": payload.requiredMaterialReceivedOn as Date) if(!isEmpty(payload.requiredMaterialReceivedOn)),
	"Required_Material_Received_On_Confidence__c": payload.requiredMaterialReceivedOnConfidenceScore,
	"Service_Order_Number__c": payload.serviceOrderNumber,
	"Service_Order_Number_Confidence__c": payload.serviceOrderNumberConfidenceScore
} filterObject ((value, key) -> value != null)
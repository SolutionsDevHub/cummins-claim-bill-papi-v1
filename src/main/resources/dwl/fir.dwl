%dw 2.0
output application/java
---
{
	"ABA_Analysis__c": payload.abaAnalysis,
	"ABA_Analysis_Confidence__c": payload.abaAnalysisConfidenceScore,
	"Action_Taken_to_Restore__c": payload.actionTakenToRestore,
	"Action_taken_to_restore_Confidence__c": payload.actionTakenToRestoreConfidenceScore,
	"Air_System__c": payload.airSystem,
	"Air_System_Confidence__c": payload.airSystemConfidenceScore,
	"Analysis__c": payload.analysis,
	"Analysis_Confidence__c": payload.analysisConfidenceScore,
	"Application_Name__c": payload.applicationName,
	"Application_Name_Confidence__c": payload.applicationNameConfidenceScore,
	"Breif_Engine_History__c": payload.briefEngineHistory,
	"Breif_Engine_History_Confidence__c": payload.briefEngineHistoryConfidenceScore,
	"Cause_of_Failure__c": payload.causeOfFailure,
	"Cause_of_Failure_Confidence__c": payload.causeOfFailureConfidenceScore,
	"Charging_Alternator_System__c": payload.chargingAlternator,
	"Charging_Alternator_System_Confidence__c": payload.chargingAlternatorConfidenceScore,
	"Claim_No__c": payload.claimNumber,
	"Claim_No_Confidence__c": payload.claimNumberConfidenceScore,
	"Complaint__c": payload.complaint,
	"Complaint_Confidence__c": payload.complaintConfidenceScore,
	"Component_Failure__c": payload.componentFailure,
	"Component_Failure_Confidence__c": payload.componentFailureConfidenceScore,
	"Cooling_System__c": payload.coolingSystem,
	"Cooling_System_Confidence__c": payload.coolingSystemConfidenceScore,
	"Correction__c": payload.correction,
	"Correction_Confidence__c": payload.correctionConfidenceScore,
	"Cumulative_Eqp_Hours__c": payload.cumulativeEqpHours,
	"Cumulative_Eqp_Hours_Confidence__c": payload.cumulativeEqpHoursConfidenceScore,
	"Customer_Complaint__c": payload.customerComplaintDetail,
	"Customer_Complaint_Confidence__c": payload.customerComplaintDetailConfidenceScore,
	"Customer_Name_Address__c": payload.customerDetails,
	"Customer_Name_Address_Confidence__c": payload.customerDetailsConfidenceScore,
	"Engine_Hours__c": payload.engineHours,
	"Engine_Hours_Confidence__c": payload.engineHoursConfidenceScore,
	"Engine_Model__c": payload.engineModel,
	"Engine_Model_Confidence__c": payload.engineModelConfidenceScore,
	"Engineer_Obseravtion__c": payload.engineerObservation,
	"Engineer_Obseravtion_Confidence__c": payload.engineerObservationConfidenceScore,
	"Equipment_Model__c": payload.equipmentModel,
	"Equipment_Model_Confidence__c": payload.equipmentModelConfidenceScore,
	"ESN__c": payload.esn,
	"ESN_Confidence__c": payload.esnConfidenceScore,
	("ESN_Billed_Date__c": payload.esnBuildDate as Date) if(!isEmpty(payload.esnBuildDate)),
	"ESN_Billed_Date_Confidence__c": payload.esnBuildDateConfidenceScore,
	"Failed_Component_Photographs__c":  if(upper(payload.failedComponentPhotographs) =="YES") true else false,
	"Failed_Component_Photographs_Confidence__c": payload.failedComponentPhotographsConfidenceScore,
	("Failure_Date__c": payload.failureDate as Date) if(!isEmpty(payload.failureDate)),
	"Failure_Date_Confidence__c": payload.failureDateConfidenceScore,
	("Failure_Reported_On__c": payload.reportDate as Date) if(!isEmpty(payload.reportDate)),
	"Failure_Reported_On_Confidence__c": payload.reportDateConfidenceScore, // Missing coolingSystem, coolingSystemConfidenceScore
	"Fuel_System__c": payload.fuelSystem,
	"Fuel_System_Confidence__c": payload.fuelSystemConfidenceScore,
	"Lubrication_System__c": payload.lubricationSystem,
	"Lubrication_System_Confidence__c": payload.lubricationSystemConfidenceScore,
	("Nepi_A_Check_Date__c": payload.nepiACheckDate as Date) if(!isEmpty(payload.nepiACheckDate)),
	"Nepi_A_Check_Date_Confidence__c": payload.nepiACheckDateConfidenceScore,
	"Operator_Version__c": payload.operatorVersionObservationDuringFailure,
	"Operator_Version_Confidence__c": payload.operatorVersionObservationDuringFailureConfidenceScore,
	"PCC_Part_No__c": payload.pccPartNo,
	"PCC_Part_No_Confidence__c": payload.pccPartNoConfidenceScore,
	"PCC_Part_Serial_No__c": payload.pccPartSerialNo,
	"PCC_Part_Serial_No_Confidence__c": payload.pccPartSerialNoConfidenceScore,
	"Service_Order_Number__c": payload.sonNumber,
	"Service_Order_Number_Confidence__c": payload.sonNumberConfidenceScore,
	"Technical_Measurement__c": payload.technicalMeasurement,
	"Technical_Measurement_Confidence__c": payload.technicalMeasurementConfidenceScore,
	"TSR_No__c": payload.tsrNumber,
	"TSR_No_Confidence__c": payload.tsrNumberConfidenceScore
} filterObject ((value, key) -> value != null)
{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"title": "Failure Investigation Request",
	"type": "object",
	"properties": {
		"applicationName": {
			"type": "string",
			"minLength": 1
		},
		"causeOfFailure": {
			"type": "string",
			"minLength": 1
		},
		"complaint": {
			"type": "string",
			"minLength": 1
		},
		"componentFailure": {
			"type": "string",
			"minLength": 1
		},
		"correction": {
			"type": "string",
			"minLength": 1
		},
		"customerComplaintDetail": {
			"type": "string",
			"minLength": 1
		},
		"failureDate": {
			"type": "string",
			"pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
		},
		"failedComponentPhotographs":{
			"type": "string",
			"enum": ["YES"]
		},
		"engineHours": {
			"type": "string",
			"minLength": 1
		},
		"engineModel": {
			"type": "string",
			"minLength": 1
		},
		"engineerObservation": {
			"type": "string",
			"minLength": 1
		},
		"equipmentModel": {
			"type": "string",
			"minLength": 1
		},
		"esn": {
			"type": "string",
			"minLength": 1
		},
		"esnBuildDate": {
			"type": "string",
			"pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
		},
		"operatorVersionObservationDuringFailure": {
			"type": "string",
			"minLength": 1
		},
		"sonNumber": {
			"type": "string",
			"minLength": 1
		},
		"itemDetails": {
			"type": "array",
			"items": {
				"type": "object",
				"properties": {
					"sonNumber": {
						"type": "string",
						"minLength": 1
					},
					"failureDate": {
						"type": "string",
						"pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
					}
				},
				"additionalProperties": true
			}
		}
	},
	"required": [
		"applicationName",
		"causeOfFailure",
		"chargingAlternator",
  		"coolingSystem",
		"correction",
		"engineHours",
		"engineModel",
		"engineerObservation",
		"equipmentModel",
		"esn",
		"esnBuildDate",
		"failedComponentPhotographs",
		"failureDate",
		"fuelSystem",
  		"lubricationSystem",
		"operatorVersionObservationDuringFailure",
		"technicalMeasurement",
		"sonNumber"
	],
	"additionalProperties": true
}
{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"title": "Invoice Request",
	"type": "object",
	"properties": {
		"invoiceDate": {
			"type": "string",
			"pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
		},
		"invoiceNumber": {
			"type": "string",
			"minLength": 1
		},
		"itemDetails": {
			"type": "array",
			"items": {
				"type": "object",
				"properties": {
					"totalAmount": {
						"type": "string",
						"minLength": 1
					},
					"itemDescription": {
						"type": "string",
						"minLength": 1
					}
				},
				"required": [
					"unitPrice",
					"itemDescription"
				],
				"additionalProperties": true
			}
		}
	},
	"required": [
		"invoiceDate",
		"invoiceNumber"
	],
	"additionalProperties": true
}
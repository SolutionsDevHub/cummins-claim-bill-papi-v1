{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"title": "ECM Request",
	"type": "object",
	"properties": {
		"esn": {
			"type": "string"
		},
		"startRepairDate": {
			"type": "string"
		},
		"endRepairDate": {
			"type": "string"
		}
	},
	"required": [
		"esn"
	],
	"anyOf": [
		{
			"required": [
				"startRepairDate"
			]
		},
		{
			"required": [
				"endRepairDate"
			]
		}
	]
}
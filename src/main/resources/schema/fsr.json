{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"title": "FSR Request",
	"type": "object",
	"properties": {
		"actualResolutionDate": {
			"type": "string",
			"pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
		},
		"attendedOn": {
			"type": "string",
			"pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
		},
		"contactNumber": {
			"type": "string",
			"minLength": 1
		},
		"contactPersonName": {
			"type": "string",
			"minLength": 1
		},
		"currentHours": {
			"type": "string",
			"minLength": 1
		},
		"customerAddress": {
			"type": "string",
			"minLength": 1
		},
		"customerComplaint": {
			"type": "string",
			"minLength": 1
		},
		"customerName": {
			"type": "string",
			"minLength": 1
		},
		"customerRequestedOn": {
			"type": "string",
			"pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
		},
		"customerSignature": {
			"type": "string",
			"enum": ["YES"]
		},
		"dealerName": {
			"type": "string",
			"minLength": 1
		},
		"diagnosisCompletedOn": {
			"type": "string",
			"pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
		},
		"engineModel": {
			"type": "string",
			"minLength": 1
		},
		"esn": {
			"type": "string",
			"minLength": 1
		},
		"failureDate": {
			"type": "string",
			"pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
		},
		"failureReportedOn": {
			"type": "string",
			"pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
		},
		"fsrDate": {
			"type": "string",
			"pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
		},
		"fsrNumber": {
			"type": "string",
			"enum": ["YES"]
		},
		"inspectionObservationAndWorkDoneInBrief": {
			"type": "string",
			"minLength": 1
		},
		"problemResolution": {
			"type": "string",
			"minLength": 1
		},
		"problemStatus": {
			"type": "string",
			"minLength": 1
		},
		"requiredMaterialReceivedOn": {
			"type": "string",
			"pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
		}
	},
	"required": [
		"actualResolutionDate",
		"attendedOn",
		"contactNumber",
		"contactPersonName",
		"customerAddress",
		"customerComplaint",
		"customerName",
		"customerRequestedOn",
		"customerSignature",
		"customerSignatureDate",
		"dealerName",
		"diagnosisCompletedOn",
		"digitalFailureCode",
		"employeeNumber",
		"esn",
		"failureDate",
		"failureReportedOn",
		"fsrDate",
		"fsrNumber",
		"inspectionObservationAndWorkDoneInBrief",
		"problemResolution",
		"problemStatus",
		"recommendationAndSuggestion",
		"serviceOrderNumber"
	],
	"additionalProperties": true
}